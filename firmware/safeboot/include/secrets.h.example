#pragma once
// Copy to secrets.h (git-ignored) and fill in.

// Wi-Fi the device joins.
#define WIFI_SSID "your-wifi"
#define WIFI_PASS "your-wifi-password"

// Protects /update, /flash.bin (full flash dump) and ArduinoOTA.
#define ADMIN_USER "admin"
#define ADMIN_PASS "change-me"

// Fallback access point when the Wi-Fi above can't be reached (diagnostics and /update stay
// reachable at 192.168.4.1). At least 8 characters.
#define AP_SSID "SmallTV-Safe"
#define AP_PASS "change-me-123"
