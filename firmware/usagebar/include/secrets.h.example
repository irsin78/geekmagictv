#pragma once
// Copy to secrets.h (git-ignored) and fill in.

// Wi-Fi the display joins.
#define WIFI_SSID "your-wifi"
#define WIFI_PASS "your-wifi-password"

// Fallback access point when the Wi-Fi above can't be reached (the web page and /update stay
// reachable at 192.168.4.1). At least 8 characters.
#define AP_SSID "SmallTV-Safe"
#define AP_PASS "change-me-123"

// Shared secret between the display and tools/push_usage.py (sent as "Authorization: Bearer ...").
// Any random string, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(18))"
#define PUSH_TOKEN "change-me"
