#pragma once
// Optional. Copy to secrets.h (git-ignored) to compile your Wi-Fi into your own build.
// Without it (and always with `pio run -e release`) the display starts the open "SmallTV-Setup"
// access point and you set the Wi-Fi on its web page instead. Wi-Fi saved there wins over this.

// Wi-Fi the display joins.
#define WIFI_SSID "your-wifi"
#define WIFI_PASS "your-wifi-password"

// Fallback access point when the Wi-Fi above can't be reached (web page and /update at 192.168.4.1).
// Leave AP_PASS empty for an open AP, or use at least 8 characters.
#define AP_SSID "SmallTV-Setup"
#define AP_PASS ""

// Optional shared secret with tools/push_usage.py ("Authorization: Bearer ..."). Without it the
// display generates one on first boot and shows it on its web page (pass it as SMALLTV_TOKEN).
// #define PUSH_TOKEN "change-me"
